# Copy to .env for local development, or to /etc/bitcade/bitcade.env on a Raspberry Pi.
BITCADE_HOST=0.0.0.0
BITCADE_PORT=8080
BITCADE_DATA_DIR=./data
BITCADE_DATABASE=./data/bitcade.db
BITCADE_SECRET_KEY=change-me-before-students-use-this
BITCADE_DEFAULT_ADMIN_USERNAME=admin
BITCADE_DEFAULT_ADMIN_PASSWORD=bitcade
BITCADE_MAX_UPLOAD_BYTES=52428800
BITCADE_SEED_SAMPLES=1
